{
  "name": "tmp-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "npm run db:setup",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:full": "npm run dev",
    "predev:test": "npm run db:setup",
    "dev:test": "APP_MODE=test VITE_APP_MODE=test PORT=4301 VITE_API_URL=http://localhost:4301/api concurrently --kill-others-on-fail \"vite --port 5174 --strictPort\" \"npm run dev:server\"",
    "dev:frontend": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:frontend",
    "build:frontend": "tsc -b && vite build",
    "prestart": "prisma generate",
    "start": "NODE_ENV=production tsx server/index.ts",
    "db:setup": "prisma generate && prisma db push",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.28.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.84.0",
    "react-router": "^7.11.0",
    "react-router-dom": "^7.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.25",
    "prisma": "^5.22.0",
    "shadcn-ui": "^0.9.5",
    "tailwindcss": "^3.4.19",
    "ts-node-dev": "^2.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
