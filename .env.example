# Core application
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-in-production"
PORT=3001
# Optional fallback for non-browser invitation requests. Normal browser requests
# automatically use the app's current host (for example, buyersync.onrender.com).
PUBLIC_APP_URL=""
# Optional when the frontend and API are deployed separately. Same-origin
# production deployments automatically use /api.
VITE_API_URL=""

# Invitation email (Mailpit local defaults shown below)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Home Buyer Sync <no-reply@homebuyersync.local>"

# Listing importer (providers run in this order, then the built-in parser)
PROPERTY_WEB_SCRAPER_URL=""
PROPERTY_WEB_SCRAPER_API_KEY=""
PROPERTY_WEB_SCRAPER_URL_PATH="/public_api/v1/listings"
PROPERTY_WEB_SCRAPER_HTML_PATH="/public_api/v1/listings"

# A separately deployed browser worker accepting POST { "url": "..." }
# and returning either raw HTML or { "html": "..." }.
PLAYWRIGHT_SERVICE_URL=""
PLAYWRIGHT_RENDER_PATH="/render"

# A separately deployed HomeHarvest adapter accepting POST search requests.
HOMEHARVEST_SERVICE_URL=""
HOMEHARVEST_SEARCH_PATH="/search"

# Comma-separated domains to add to the Zillow/Realtor/Redfin allowlist.
LISTING_IMPORT_ALLOWED_HOSTS=""

# Optional contextual advertising network. BuyerSync renders provider-neutral
# data-ad-publisher, data-ad-slot, and data-ad-placement attributes.
CONTEXTUAL_AD_SCRIPT_URL=""
CONTEXTUAL_AD_PUBLISHER_ID=""
CONTEXTUAL_AD_LEFT_SLOT=""
CONTEXTUAL_AD_RIGHT_SLOT=""
CONTEXTUAL_AD_BOTTOM_SLOT=""